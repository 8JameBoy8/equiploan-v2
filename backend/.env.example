# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องของคุณ (ห้าม commit ไฟล์ .env)

# พอร์ตที่ backend รับคำขอ
PORT=4000

# การเชื่อมต่อ PostgreSQL: postgres://ผู้ใช้:รหัสผ่าน@โฮสต์:พอร์ต/ชื่อฐานข้อมูล
DATABASE_URL=postgres://equiploan:CHANGE_ME@localhost:5432/equiploan

# คีย์ลับสำหรับเซ็น token ใน cookie (สุ่มยาวๆ อย่างน้อย 32 ตัวอักษร)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ตั้งเป็น true เมื่อใช้งานผ่าน HTTPS (ตอนพัฒนาบนเครื่องใช้ false)
COOKIE_SECURE=false

# บัญชี admin ที่ระบบสร้างให้อัตโนมัติตอนเริ่มทำงาน (ถ้ายังไม่มี)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_NAME=ผู้ดูแลระบบ

# โฟลเดอร์เก็บรูปที่อัปโหลด (ใช้ในเฟสถัดไป)
UPLOAD_DIR=./uploads
